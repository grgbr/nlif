menu "Sysrepo plugin"

config SRPLUG_ASSERT
	bool "Assertion"
	default n
	help
	  Build srplug with assertions enabled to perform full verification of
	  arguments consistency as well as internal state.

config SRPLUG_DEBUG
	bool "Debug"
	default n
	help
	  Build srplug in debug mode, enabling additional debugging messages,
	  additional internal state consistency checks as well as full memory
	  cleanup logic suitable for memory error detection tools such as
	  Valgrind's Memcheck and co.

config SRPLUG_LOG
	bool
	default n

config SRPLUG_DAEMON
	bool "Daemon"
	default n
	help
	  Build srplug with support daemonized plugin running into their own
	  process.

config SRPLUG_DAEMON_CONFIG
	bool
	depends on SRPLUG_DAEMON && SRPLUG_LOG
	default SRPLUG_DAEMON && SRPLUG_LOG

config SRPLUG_DAEMON_STDLOG
	bool "STDIO logging"
	depends on SRPLUG_DAEMON
	select SRPLUG_LOG
	default n
	help
	  Build srplug with support for logging messages to stdio(3)
	  streams.

choice
	prompt "STDIO logging default severity"
	depends on SRPLUG_DAEMON_STDLOG
	default SRPLUG_DAEMON_STDLOG_SEVERITY_WARNING
	help
	  By default, srplug daemon logging messages with severity greater that
	  this won't be sent to stdio(3) stream logger.
	  See syslog(3) levels for more informations about available severities.

config SRPLUG_DAEMON_STDLOG_SEVERITY_EMERG
	bool "emergency"

config SRPLUG_DAEMON_STDLOG_SEVERITY_ALERT
	bool "alert"

config SRPLUG_DAEMON_STDLOG_SEVERITY_CRIT
	bool "critical"

config SRPLUG_DAEMON_STDLOG_SEVERITY_ERR
	bool "error"

config SRPLUG_DAEMON_STDLOG_SEVERITY_WARNING
	bool "warning"

config SRPLUG_DAEMON_STDLOG_SEVERITY_NOTICE
	bool "notice"

config SRPLUG_DAEMON_STDLOG_SEVERITY_INFO
	bool "information"

config SRPLUG_DAEMON_STDLOG_SEVERITY_DEBUG
	bool "debug"
	depends on SRPLUG_DEBUG

endchoice

config SRPLUG_DAEMON_STDLOG_SEVERITY_VALUE
	int
	depends on SRPLUG_DAEMON_STDLOG
	default 0 if SRPLUG_DAEMON_STDLOG_SEVERITY_EMERG
	default 1 if SRPLUG_DAEMON_STDLOG_SEVERITY_ALERT
	default 2 if SRPLUG_DAEMON_STDLOG_SEVERITY_CRIT
	default 3 if SRPLUG_DAEMON_STDLOG_SEVERITY_ERR
	default 4 if SRPLUG_DAEMON_STDLOG_SEVERITY_WARNING
	default 5 if SRPLUG_DAEMON_STDLOG_SEVERITY_NOTICE
	default 6 if SRPLUG_DAEMON_STDLOG_SEVERITY_INFO
	default 7 if SRPLUG_DAEMON_STDLOG_SEVERITY_DEBUG

config SRPLUG_DAEMON_STDLOG_SEVERITY_STRING
	string
	depends on SRPLUG_DAEMON_STDLOG
	default "emerg" if SRPLUG_DAEMON_STDLOG_SEVERITY_EMERG
	default "alert" if SRPLUG_DAEMON_STDLOG_SEVERITY_ALERT
	default "crit" if SRPLUG_DAEMON_STDLOG_SEVERITY_CRIT
	default "err" if SRPLUG_DAEMON_STDLOG_SEVERITY_ERR
	default "warn" if SRPLUG_DAEMON_STDLOG_SEVERITY_WARNING
	default "notice" if SRPLUG_DAEMON_STDLOG_SEVERITY_NOTICE
	default "info" if SRPLUG_DAEMON_STDLOG_SEVERITY_INFO
	default "debug" if SRPLUG_DAEMON_STDLOG_SEVERITY_DEBUG

config SRPLUG_DAEMON_SYSLOG
	bool "Syslog logging"
	depends on SRPLUG_DAEMON
	select SRPLUG_LOG
	default y
	help
	  Build srplug with support for logging messages to syslog(3).

choice
	prompt "Syslog logging default severity"
	depends on SRPLUG_DAEMON_SYSLOG
	default SRPLUG_DAEMON_SYSLOG_SEVERITY_WARNING
	help
	  By default, srplug daemon logging messages with severity greater that
	  this won't be sent to syslog(3) logger.
	  See syslog(3) levels for more informations about available severities.

config SRPLUG_DAEMON_SYSLOG_SEVERITY_EMERG
	bool "emergency"

config SRPLUG_DAEMON_SYSLOG_SEVERITY_ALERT
	bool "alert"

config SRPLUG_DAEMON_SYSLOG_SEVERITY_CRIT
	bool "critical"

config SRPLUG_DAEMON_SYSLOG_SEVERITY_ERR
	bool "error"

config SRPLUG_DAEMON_SYSLOG_SEVERITY_WARNING
	bool "warning"

config SRPLUG_DAEMON_SYSLOG_SEVERITY_NOTICE
	bool "notice"

config SRPLUG_DAEMON_SYSLOG_SEVERITY_INFO
	bool "information"

config SRPLUG_DAEMON_SYSLOG_SEVERITY_DEBUG
	bool "debug"
	depends on SRPLUG_DEBUG

endchoice

config SRPLUG_DAEMON_SYSLOG_SEVERITY_VALUE
	int
	depends on SRPLUG_DAEMON_SYSLOG
	default 0 if SRPLUG_DAEMON_SYSLOG_SEVERITY_EMERG
	default 1 if SRPLUG_DAEMON_SYSLOG_SEVERITY_ALERT
	default 2 if SRPLUG_DAEMON_SYSLOG_SEVERITY_CRIT
	default 3 if SRPLUG_DAEMON_SYSLOG_SEVERITY_ERR
	default 4 if SRPLUG_DAEMON_SYSLOG_SEVERITY_WARNING
	default 5 if SRPLUG_DAEMON_SYSLOG_SEVERITY_NOTICE
	default 6 if SRPLUG_DAEMON_SYSLOG_SEVERITY_INFO
	default 7 if SRPLUG_DAEMON_SYSLOG_SEVERITY_DEBUG

config SRPLUG_DAEMON_SYSLOG_SEVERITY_STRING
	string
	depends on SRPLUG_DAEMON_SYSLOG
	default "emerg" if SRPLUG_DAEMON_SYSLOG_SEVERITY_EMERG
	default "alert" if SRPLUG_DAEMON_SYSLOG_SEVERITY_ALERT
	default "crit" if SRPLUG_DAEMON_SYSLOG_SEVERITY_CRIT
	default "err" if SRPLUG_DAEMON_SYSLOG_SEVERITY_ERR
	default "warn" if SRPLUG_DAEMON_SYSLOG_SEVERITY_WARNING
	default "notice" if SRPLUG_DAEMON_SYSLOG_SEVERITY_NOTICE
	default "info" if SRPLUG_DAEMON_SYSLOG_SEVERITY_INFO
	default "debug" if SRPLUG_DAEMON_SYSLOG_SEVERITY_DEBUG

choice
	prompt "Syslog logging default facility"
	depends on SRPLUG_DAEMON_SYSLOG
	default SRPLUG_DAEMON_SYSLOG_FACILITY_DAEMON
	help
	  By default, srplug daemon messages are logged to syslog(3) using this
	  facility.
	  See syslog(3) for more informations about available facilities.

config SRPLUG_DAEMON_SYSLOG_FACILITY_USER
	bool "user"

config SRPLUG_DAEMON_SYSLOG_FACILITY_MAIL
	bool "mail"

config SRPLUG_DAEMON_SYSLOG_FACILITY_DAEMON
	bool "daemon"

config SRPLUG_DAEMON_SYSLOG_FACILITY_AUTH
	bool "auth"

config SRPLUG_DAEMON_SYSLOG_FACILITY_SYSLOG
	bool "syslog"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LPR
	bool "lpr"

config SRPLUG_DAEMON_SYSLOG_FACILITY_NEWS
	bool "news"

config SRPLUG_DAEMON_SYSLOG_FACILITY_UUCP
	bool "uucp"

config SRPLUG_DAEMON_SYSLOG_FACILITY_CRON
	bool "cron"

config SRPLUG_DAEMON_SYSLOG_FACILITY_AUTHPRIV
	bool "authpriv"

config SRPLUG_DAEMON_SYSLOG_FACILITY_FTP
	bool "ftp"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL0
	bool "local0"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL1
	bool "local1"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL2
	bool "local2"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL3
	bool "local3"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL4
	bool "local4"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL5
	bool "local5"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL6
	bool "local6"

config SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL7
	bool "local7"

endchoice

config SRPLUG_DAEMON_SYSLOG_FACILITY_VALUE
	int
	depends on SRPLUG_DAEMON_SYSLOG
	default 8 if SRPLUG_DAEMON_SYSLOG_FACILITY_USER
	default 16 if SRPLUG_DAEMON_SYSLOG_FACILITY_MAIL
	default 24 if SRPLUG_DAEMON_SYSLOG_FACILITY_DAEMON
	default 32 if SRPLUG_DAEMON_SYSLOG_FACILITY_AUTH
	default 40 if SRPLUG_DAEMON_SYSLOG_FACILITY_SYSLOG
	default 48  if SRPLUG_DAEMON_SYSLOG_FACILITY_LPR
	default 56  if SRPLUG_DAEMON_SYSLOG_FACILITY_NEWS
	default 64  if SRPLUG_DAEMON_SYSLOG_FACILITY_UUCP
	default 72  if SRPLUG_DAEMON_SYSLOG_FACILITY_CRON
	default 80  if SRPLUG_DAEMON_SYSLOG_FACILITY_AUTHPRIV
	default 88  if SRPLUG_DAEMON_SYSLOG_FACILITY_FTP
	default 128 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL0
	default 136 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL1
	default 144 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL2
	default 152 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL3
	default 160 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL4
	default 168 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL5
	default 176 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL6
	default 184 if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL7

config SRPLUG_DAEMON_SYSLOG_FACILITY_STRING
	string
	depends on SRPLUG_DAEMON_SYSLOG
	default "user" if SRPLUG_DAEMON_SYSLOG_FACILITY_USER
	default "mail" if SRPLUG_DAEMON_SYSLOG_FACILITY_MAIL
	default "daemon" if SRPLUG_DAEMON_SYSLOG_FACILITY_DAEMON
	default "auth" if SRPLUG_DAEMON_SYSLOG_FACILITY_AUTH
	default "syslog" if SRPLUG_DAEMON_SYSLOG_FACILITY_SYSLOG
	default "lpr" if SRPLUG_DAEMON_SYSLOG_FACILITY_LPR
	default "news" if SRPLUG_DAEMON_SYSLOG_FACILITY_NEWS
	default "uucp" if SRPLUG_DAEMON_SYSLOG_FACILITY_UUCP
	default "cron" if SRPLUG_DAEMON_SYSLOG_FACILITY_CRON
	default "authpriv" if SRPLUG_DAEMON_SYSLOG_FACILITY_AUTHPRIV
	default "ftp" if SRPLUG_DAEMON_SYSLOG_FACILITY_FTP
	default "local0" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL0
	default "local1" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL1
	default "local2" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL2
	default "local3" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL3
	default "local4" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL4
	default "local5" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL5
	default "local6" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL6
	default "local7" if SRPLUG_DAEMON_SYSLOG_FACILITY_LOCAL7

endmenu # "Sysrepo plugin"

config NLIF_ASSERT
	bool "Assertion"
	default n
	help
	  Build nlif with assertions enabled to perform full verification of
	  arguments consistency as well as internal state.

config NLIF_DEBUG
	bool "Debug"
	default n
	help
	  Build nlif in debug mode, enabling additional debugging messages,
	  additional internal state consistency checks as well as full memory
	  cleanup logic suitable for memory error detection tools such as
	  Valgrind's Memcheck and co.

config NLIF_LOG
	bool "Logging"
	default y
	help
	  Build nlif with support for logging messages.

config NLIF_PRINT
	bool "Object printing"
	default n
	help
	  Build nlif with support for displaying objects content on
	  console.

config NLIF_STORE
	bool "Object store"
	default n
	help
	  Build nlif with support for an object store that may serve as a
	  caching mechanism when coupled with asynchronous object notifications.

config NLIF_NOTIF
	bool "Notification"
	default n
	help
	  Build nlif with support for asynchronous object notifications.

config NLIF_DAEMON
	bool "nlifd daemon"
	select NLIF_NOTIF
	select NLIF_STORE
	default y
	help
	  Build the nlifd management daemon.

config NLIF_SAMPLE
	bool "Sample code"
	default n
	help
	  Build various sample code binaries showing how to use nlif internals.

config NLIF_SAMPLE_SHOW
	bool "nlif-show sample"
	depends on NLIF_SAMPLE
	select NLIF_STORE
	select NLIF_LOG
	default n
	help
	  Build the nlif-show sample code that demonstrates how to retrieve and
	  display managed objects.

config NLIF_SAMPLE_MON
	bool "nlif-mon sample"
	depends on NLIF_SAMPLE
	select NLIF_STORE
	select NLIF_NOTIF
	select NLIF_LOG
	default n
	help
	  Build the nlif-mon sample code that demonstrates how to retrieve and
	  monitor state changes of managed objets.

# ex: ft=kconfig:
