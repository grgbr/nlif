config NLIF_ASSERT
	bool "Assertion"
	default n
	help
	  Build nlif with assertions enabled to perform full verification of
	  arguments consistency as well as internal state.

config NLIF_DEBUG
	bool "Debug"
	default n
	help
	  Build nlif in debug mode, enabling additional debugging messages,
	  additional internal state consistency checks as well as full memory
	  cleanup logic suitable for memory error detection tools such as
	  Valgrind's Memcheck and co.

config NLIF_LOG
	bool "Logging"
	default y
	help
	  Build nlif with support for logging messages.

config NLIF_PRINT
	bool "Object printing"
	default n
	help
	  Build nlif with support for displaying objects content on
	  console.

config NLIF_STORE
	bool "Object store"
	default n
	help
	  Build nlif with support for an object store that may serve as a
	  caching mechanism when coupled with asynchronous object notifications.

config NLIF_NOTIF
	bool "Notification"
	default n
	help
	  Build nlif with support for asynchronous object notifications.

config NLIF_DAEMON
	bool "nlifd daemon"
	select NLIF_NOTIF
	select NLIF_STORE
	default y
	help
	  Build the nlifd management daemon.

config NLIF_DAEMON_STDLOG
	bool "STDIO logging"
	depends on NLIF_DAEMON && NLIF_LOG
	default y
	help
	  Build nlif with support for logging messages to stdio(3)
	  streams.

config NLIF_DAEMON_STDLOG_SEVERITY
	int "STDIO logging default severity"
	depends on NLIF_DAEMON_STDLOG
	range 0 7
	default 3
	help
	  By default, nlifd daemon logging messages with severity greater that
	  this won't be sent to stdio(3) stream logger.
	  See syslog(3) levels for more informations about available severities.

config NLIF_DAEMON_SYSLOG
	bool "Syslog logging"
	depends on NLIF_DAEMON && NLIF_LOG
	default y
	help
	  Build nlif with support for logging messages to syslog(3).

config NLIF_DAEMON_SYSLOG_SEVERITY
	int "Syslog logging default severity"
	depends on NLIF_DAEMON_SYSLOG
	range 0 7
	default 3
	help
	  By default, nlifd daemon logging messages with severity greater that
	  this won't be sent to syslog(3) logger.
	  See syslog(3) levels for more informations about available severities.

choice
	prompt "Syslog logging default facility"
	depends on NLIF_DAEMON_SYSLOG
	default NLIF_DAEMON_SYSLOG_FACILITY_DAEMON
	help
	  By default, nlifd daemon messages are logged to syslog(3) using this
	  facility.
	  See syslog(3) for more informations about available facilities.

config NLIF_DAEMON_SYSLOG_FACILITY_USER
	bool "user"

config NLIF_DAEMON_SYSLOG_FACILITY_MAIL
	bool "mail"

config NLIF_DAEMON_SYSLOG_FACILITY_DAEMON
	bool "daemon"

config NLIF_DAEMON_SYSLOG_FACILITY_AUTH
	bool "auth"

config NLIF_DAEMON_SYSLOG_FACILITY_SYSLOG
	bool "syslog"

config NLIF_DAEMON_SYSLOG_FACILITY_LPR
	bool "lpr"

config NLIF_DAEMON_SYSLOG_FACILITY_NEWS
	bool "news"

config NLIF_DAEMON_SYSLOG_FACILITY_UUCP
	bool "uucp"

config NLIF_DAEMON_SYSLOG_FACILITY_CRON
	bool "cron"

config NLIF_DAEMON_SYSLOG_FACILITY_AUTHPRIV
	bool "authpriv"

config NLIF_DAEMON_SYSLOG_FACILITY_FTP
	bool "ftp"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL0
	bool "local0"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL1
	bool "local1"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL2
	bool "local2"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL3
	bool "local3"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL4
	bool "local4"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL5
	bool "local5"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL6
	bool "local6"

config NLIF_DAEMON_SYSLOG_FACILITY_LOCAL7
	bool "local7"

endchoice

config NLIF_DAEMON_SYSLOG_FACILITY_VALUE
	int
	depends on NLIF_DAEMON_SYSLOG
	default 8 if NLIF_DAEMON_SYSLOG_FACILITY_USER
	default 16 if NLIF_DAEMON_SYSLOG_FACILITY_MAIL
	default 24 if NLIF_DAEMON_SYSLOG_FACILITY_DAEMON
	default 32 if NLIF_DAEMON_SYSLOG_FACILITY_AUTH
	default 40 if NLIF_DAEMON_SYSLOG_FACILITY_SYSLOG
	default 48  if NLIF_DAEMON_SYSLOG_FACILITY_LPR
	default 56  if NLIF_DAEMON_SYSLOG_FACILITY_NEWS
	default 64  if NLIF_DAEMON_SYSLOG_FACILITY_UUCP
	default 72  if NLIF_DAEMON_SYSLOG_FACILITY_CRON
	default 80  if NLIF_DAEMON_SYSLOG_FACILITY_AUTHPRIV
	default 88  if NLIF_DAEMON_SYSLOG_FACILITY_FTP
	default 128 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL0
	default 136 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL1
	default 144 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL2
	default 152 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL3
	default 160 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL4
	default 168 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL5
	default 176 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL6
	default 184 if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL7

config NLIF_DAEMON_SYSLOG_FACILITY_STRING
	string
	depends on NLIF_DAEMON_SYSLOG
	default "user" if NLIF_DAEMON_SYSLOG_FACILITY_USER
	default "mail" if NLIF_DAEMON_SYSLOG_FACILITY_MAIL
	default "daemon" if NLIF_DAEMON_SYSLOG_FACILITY_DAEMON
	default "auth" if NLIF_DAEMON_SYSLOG_FACILITY_AUTH
	default "syslog" if NLIF_DAEMON_SYSLOG_FACILITY_SYSLOG
	default "lpr" if NLIF_DAEMON_SYSLOG_FACILITY_LPR
	default "news" if NLIF_DAEMON_SYSLOG_FACILITY_NEWS
	default "uucp" if NLIF_DAEMON_SYSLOG_FACILITY_UUCP
	default "cron" if NLIF_DAEMON_SYSLOG_FACILITY_CRON
	default "authpriv" if NLIF_DAEMON_SYSLOG_FACILITY_AUTHPRIV
	default "ftp" if NLIF_DAEMON_SYSLOG_FACILITY_FTP
	default "local0" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL0
	default "local1" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL1
	default "local2" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL2
	default "local3" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL3
	default "local4" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL4
	default "local5" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL5
	default "local6" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL6
	default "local7" if NLIF_DAEMON_SYSLOG_FACILITY_LOCAL7

config NLIF_SAMPLE
	bool "Sample code"
	default n
	help
	  Build various sample code binaries showing how to use nlif internals.

config NLIF_SAMPLE_SHOW
	bool "nlif-show sample"
	depends on NLIF_SAMPLE
	select NLIF_STORE
	select NLIF_LOG
	default n
	help
	  Build the nlif-show sample code that demonstrates how to retrieve and
	  display managed objects.

config NLIF_SAMPLE_MON
	bool "nlif-mon sample"
	depends on NLIF_SAMPLE
	select NLIF_STORE
	select NLIF_NOTIF
	select NLIF_LOG
	default n
	help
	  Build the nlif-mon sample code that demonstrates how to retrieve and
	  monitor state changes of managed objets.

# ex: ft=kconfig:
